{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "noUpdateNotifier": true,
  "globalPassThroughEnv": [
    "BUN_EXECUTABLE",
    "TMPDIR",
    "XDG_RUNTIME_DIR",
    "TATTLER_RUNTIME_NAMESPACE",
    "PI_PACKAGE_DIR",
    "PI_SKIP_VERSION_CHECK",
    "GITHUB_TOKEN",
    "GH_TOKEN",
    "USERNAME",
    "SANDPIPER_CODING_AGENT_DIR"
  ],
  "globalDependencies": [
    "packages/core/src/**/*.ts",
    "packages/core/package.json",
    "packages/capability-autotoon/src/**/*.ts",
    "packages/capability-autotoon/package.json"
  ],
  "tasks": {
    "sandpiper-ai-cli#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "$TURBO_ROOT$/extensions/**/*.ts",
        "$TURBO_ROOT$/packages/resources/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/devtools/stageCliResources.ts"
      ],
      "outputs": ["dist/**", "docs/**"]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "$TURBO_ROOT$/extensions/**/*.ts",
        "$TURBO_ROOT$/plugins/**/*.ts"
      ],
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "**/*.map"]
    }
  }
}
