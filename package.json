{
  "name": "sandpiper-ai",
  "version": "0.0.1",
  "packageManager": "bun@1.3.13",
  "author": "Doug Stephen <dljs.jr@dougstephenjr.com>",
  "homepage": "https://github.com/dljsjr/sandpiper-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dljsjr/sandpiper-ai.git"
  },
  "private": true,
  "bin": {
    "sandpiper": "./packages/cli/bin/sandpiper",
    "sandpiper-system-prompt": "./packages/cli/bin/sandpiper-system-prompt"
  },
  "piConfig": {
    "name": "sandpiper",
    "configDir": ".sandpiper",
    "bin": "sandpiper"
  },
  "scripts": {
    "check:biome-fmt": "biome format",
    "check:biome-lint": "biome lint",
    "check:biome-check": "biome check",
    "check:tsc": "tsc --noEmit",
    "check:ast-grep": "ast-grep scan",
    "check": "bun run check:deps && bun run check:tsc && bun run check:biome-check",
    "test": "bun run build && bun run test:vitest",
    "test:vitest": "env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null JJ_CONFIG=\"$PWD/packages/trail/test-fixtures/jj-test-config.toml\" vitest run",
    "test:standalone": "bun run build:standalone && bun run test:vitest -- packages/cli/standalone_bootstrap.test.ts packages/cli/sandpiper_resources.test.ts packages/cli/standalone_cli_smoke.test.ts packages/cli/standalone_resource_discovery.test.ts packages/cli/system_prompt_diagnostic.test.ts",
    "build:packages": "turbo run build --filter=sandpiper-ai-core --filter=sandpiper-standup-cli --filter=@sandpiper-ai/trail --filter=sandpiper-ai-cli",
    "sync:skill-helpers": "bun --bun devtools/syncSkillHelpers.ts",
    "build": "rm -rf dist && bun run build:packages && bun run sync:skill-helpers",
    "build:standalone": "bun --filter sandpiper-ai-cli build",
    "clean": "bun devtools/clean.ts",
    "sandpiper-dev": "bun run --bun ./packages/cli/sandpiper_standalone.ts",
    "sandpiper-built": "bun ./packages/cli/bin/sandpiper",
    "system-prompt-dev": "bun run --bun ./packages/cli/sandpiper_system_prompt.ts",
    "system-prompt-built": "bun ./packages/cli/bin/sandpiper-system-prompt",
    "check:knip": "knip",
    "check:knip:production": "knip --production",
    "check:deps": "syncpack lint"
  },
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "dependencies": {
    "@sandpiper-ai/trail": "workspace:*",
    "better-sqlite3": "13.0.3",
    "sandpiper-ai-cli": "workspace:*",
    "sandpiper-ai-core": "workspace:*",
    "sandpiper-standup-cli": "workspace:*",
    "sanitize-filename": "1.6.4",
    "tmp": "0.2.7",
    "uuid": "14.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.5.0",
    "commander": "15.0.0",
    "knip": "6.35.1",
    "syncpack": "15.3.3",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "license": "MIT",
  "type": "module",
  "patchedDependencies": {
    "@earendil-works/pi-coding-agent@1.3.0": "patches/@earendil-works%2Fpi-coding-agent@1.3.0.patch"
  }
}
