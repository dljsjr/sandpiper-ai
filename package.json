{
  "name": "sandpiper-ai",
  "version": "0.0.1",
  "author": "Doug Stephen <dljs.jr@dougstephenjr.com>",
  "homepage": "https://github.com/dljsjr/sandpiper-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dljsjr/sandpiper-ai.git"
  },
  "private": true,
  "scripts": {
    "preinstall": "bash devtools/vendor.sh --if-missing && bash devtools/preinstall.sh && bun --workspaces --if-present preinstall",
    "postinstall": "bash devtools/postinstall.sh",
    "check:biome-fmt": "biome format",
    "check:biome-lint": "biome lint",
    "check:biome-check": "biome check",
    "check:tsc": "tsc --noEmit",
    "check:ast-grep": "ast-grep scan",
    "check": "bun run check:tsc && bun run check:biome-check",
    "test:standalone": "bun x vitest run packages/cli/standalone_bootstrap.test.ts packages/cli/sandpiper_resources.test.ts packages/cli/standalone_cli_smoke.test.ts packages/cli/standalone_resource_discovery.test.ts",
    "test:distribution": "bun run prepare:distribution && vitest run devtools/distribution-invariants.test.ts devtools/distribution-smoke.test.ts devtools/ecosystemPackage.test.ts devtools/neutralPiPackage.test.ts devtools/neutralPiPackageSmoke.test.ts && bun run test:standalone && bun run test:standalone-app && bun run test:claude-plugin",
    "test:neutral-pi-package": "bun run build:neutral-pi-package && vitest run devtools/neutralPiPackage.test.ts devtools/neutralPiPackageSmoke.test.ts",
    "test:standalone-app": "vitest run devtools/standaloneSandpiperApp.test.ts && vitest run devtools/standaloneSandpiperAppCompile.test.ts && vitest run devtools/standaloneSandpiperAppRuntime.test.ts",
    "test:claude-plugin": "bun run prepare:distribution && bun --filter sandpiper-adapter-claude-code build && vitest run packages/adapter-claude-code/src/autotoon-post-tool-use.test.ts devtools/claudeCodePlugin.test.ts devtools/claudeCodePluginHookSmoke.test.ts",
    "build:legacy-cli": "mkdir -p packages/cli/dist && bun build --production --minify --target=node ./packages/cli/pi_wrapper.ts --outfile ./packages/cli/dist/sandpiper",
    "build:neutral-pi-package": "bun run --bun devtools/neutralPiPackage.ts",
    "prepare:standalone-app": "bun run --bun devtools/standaloneSandpiperApp.ts",
    "build:standalone-app": "bun run --bun devtools/standaloneSandpiperApp.ts --compile",
    "prepare:claude-plugin": "bun run prepare:distribution && bun --bun devtools/claudeCodePlugin.ts",
    "build:claude-plugin": "bun run prepare:distribution && bun --bun devtools/claudeCodePlugin.ts --build",
    "prepare:distribution": "bun --filter sandpiper-ai-core build && bun --filter sandpiper-standup-cli build && bun --filter sandpiper-tasks-cli build && bun run build:legacy-cli && bash devtools/postinstall.sh && bun run build:neutral-pi-package",
    "build": "bun --filter sandpiper-ai-cli build",
    "build:standalone": "bun --filter sandpiper-ai-cli build:standalone",
    "vendor": "bash devtools/vendor.sh",
    "clean": "bun devtools/clean.ts",
    "sandpiper-dev": "bun run --bun ./packages/cli/pi_wrapper.ts",
    "sandpiper-standalone-dev": "bun run --bun ./packages/cli/sandpiper_standalone.ts",
    "sandpiper-standalone-built": "bun ./packages/cli/dist/standalone/sandpiper_standalone.js"
  },
  "bin": {
    "sandpiper": "./dist/sandpiper",
    "sandpiper-tasks": "./packages/sandpiper-tasks-cli/dist/sandpiper-tasks",
    "sandpiper-standup": "./packages/sandpiper-standup-cli/dist/sandpiper-standup"
  },
  "files": [
    "./dist"
  ],
  "keywords": [
    "pi-package"
  ],
  "piConfig": {
    "name": "sandpiper",
    "configDir": ".sandpiper",
    "bin": "sandpiper"
  },
  "pi": {
    "extensions": [
      "./extensions/system.ts",
      "./extensions/shell-relay",
      "./extensions/web-fetch",
      "./extensions/autotoon"
    ],
    "skills": [
      "./skills/sandpiper",
      "./skills/third-party"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "extensions/*",
      "devtools/"
    ],
    "catalogs": {
      "bun": {
        "bun": "1.3.11"
      },
      "cli": {
        "commander": "14.0.3",
        "@commander-js/extra-typings": "14.0.0",
        "chalk": "5.6.2",
        "supports-color": "10.2.2"
      },
      "pi": {
        "@mariozechner/pi-coding-agent": "0.72.0",
        "@mariozechner/pi-tui": "0.72.0",
        "@silvia-odwyer/photon-node": "0.3.4",
        "@sinclair/typebox": "0.34.49"
      },
      "ts": {
        "typescript": "6.0.3",
        "@types/node": "25.6.0",
        "@types/bun": "1.3.13"
      },
      "web": {
        "@mozilla/readability": "0.6.0",
        "jsdom": "29.1.1",
        "turndown": "7.2.4",
        "@types/jsdom": "28.0.1",
        "@types/turndown": "5.0.6"
      },
      "testing": {
        "vitest": "4.1.5"
      },
      "tooling": {
        "@biomejs/biome": "2.4.14",
        "ascii-motion-mcp": "^2.1",
        "mcporter": "0.9.0",
        "canvas": "3.2.3"
      },
      "codec": {
        "fast-xml-parser": "5.7.2"
      }
    }
  },
  "dependencies": {
    "chalk": "5.6.2",
    "fast-xml-parser": "5.7.2",
    "sandpiper-ai-cli": "0.0.1",
    "sandpiper-ai-core": "0.0.1",
    "sandpiper-standup-cli": "0.0.1",
    "sandpiper-tasks-cli": "0.0.1",
    "supports-color": "10.2.2"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@commander-js/extra-typings": "14.0.0",
    "@types/node": "25.6.0",
    "commander": "14.0.3",
    "mcporter": "0.9.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "license": "MIT",
  "type": "module"
}
