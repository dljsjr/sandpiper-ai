{
  "name": "sandpiper-ai-cli",
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "author": "Doug Stephen <dljs.jr@dougstephenjr.com>",
  "homepage": "https://github.com/dljsjr/sandpiper-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dljsjr/sandpiper-ai.git"
  },
  "private": true,
  "files": [
    "packages/cli/bin/",
    "packages/core/system-prompt/",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "docs/",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "bin": {
    "sandpiper": "./packages/cli/bin/sandpiper",
    "sandpiper-system-prompt": "./packages/cli/bin/sandpiper-system-prompt"
  },
  "piConfig": {
    "name": "sandpiper",
    "configDir": ".sandpiper",
    "bin": "sandpiper"
  },
  "scripts": {
    "check:biome-check": "biome check",
    "check:tsc": "tsc --noEmit",
    "check:markdown": "prettier --check \"**/*.md\"",
    "check": "bun run check:tsc && bun run check:biome-check && bun run check:knip && bun run check:markdown",
    "test": "bun run build && bun run test:vitest",
    "test:vitest": "env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null JJ_CONFIG=\"$PWD/devtools/test-fixtures/jj-test-config.toml\" vitest run",
    "build": "rm -rf dist && bun build --sourcemap --production --minify --target=bun --splitting --chunk-naming 'chunks/[name]-[hash].[ext]' --external jsdom --external '@earendil-works/*' ./packages/cli/sandpiper_standalone.ts ./packages/cli/sandpiper_system_prompt.ts --outdir ./dist",
    "pack:cli": "bun run build && bun pm pack --ignore-scripts --destination ./dist",
    "sandpiper-dev": "bun run --bun ./packages/cli/sandpiper_standalone.ts",
    "sandpiper-built": "bun ./packages/cli/bin/sandpiper",
    "system-prompt-dev": "bun run --bun ./packages/cli/sandpiper_system_prompt.ts",
    "check:knip": "knip",
    "check:knip:production": "knip --production"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "jsdom": "30.0.1"
  },
  "bundledDependencies": [
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@earendil-works/pi-mcp",
    "@earendil-works/pi-tui",
    "jsdom"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@mozilla/readability": "0.6.0",
    "@toon-format/toon": "4.1.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.5.0",
    "@types/turndown": "5.0.6",
    "diff": "9.0.0",
    "happy-dom": "20.11.2",
    "knip": "6.35.1",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-to-string": "4.0.0",
    "prettier": "3.10.0",
    "sanitize-filename": "1.6.4",
    "tmp": "0.2.7",
    "turndown": "7.2.4",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "uuid": "14.0.2",
    "vitest": "5.0.0"
  },
  "license": "MIT",
  "type": "module",
  "patchedDependencies": {
    "@earendil-works/pi-coding-agent@1.5.2": "patches/@earendil-works%2Fpi-coding-agent@1.5.2.patch"
  }
}
