{
  "name": "sandpiper-ai",
  "version": "0.0.1",
  "packageManager": "bun@1.3.13",
  "author": "Doug Stephen <dljs.jr@dougstephenjr.com>",
  "homepage": "https://github.com/dljsjr/sandpiper-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dljsjr/sandpiper-ai.git"
  },
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "sandpiper": "./packages/cli/bin/sandpiper"
  },
  "piConfig": {
    "name": "sandpiper",
    "configDir": ".sandpiper",
    "bin": "sandpiper"
  },
  "pi": {
    "extensions": [
      "./plugins/pi/extensions"
    ],
    "skills": [
      "./packages/resources/skills/sandpiper",
      "./packages/resources/skills/third-party"
    ],
    "prompts": [
      "./packages/resources/prompts"
    ],
    "themes": [
      "./packages/resources/themes"
    ]
  },
  "scripts": {
    "check:biome-fmt": "biome format",
    "check:biome-lint": "biome lint",
    "check:biome-check": "biome check",
    "check:tsc": "tsc --noEmit",
    "check:ast-grep": "ast-grep scan",
    "check": "bun run check:deps && bun run check:tsc && bun run check:biome-check",
    "test": "bun run prepare:distribution && bun run test:vitest",
    "test:vitest": "env -u PI_PACKAGE_DIR vitest run",
    "test:standalone": "bun run test:vitest -- packages/cli/standalone_bootstrap.test.ts packages/cli/sandpiper_resources.test.ts packages/cli/standalone_cli_smoke.test.ts packages/cli/standalone_resource_discovery.test.ts",
    "test:distribution": "bun run prepare:distribution && bun run test:vitest -- devtools/distribution-invariants.test.ts devtools/distribution-smoke.test.ts devtools/ecosystemPackage.test.ts devtools/npmPackageInstallSmoke.test.ts devtools/rootPiPackageSmoke.test.ts && bun run test:standalone && bun run test:standalone-app && bun run test:claude-plugin",
    "test:standalone-app": "bun run test:vitest -- devtools/standaloneSandpiperApp.test.ts && bun run test:vitest -- devtools/standaloneSandpiperAppCompile.test.ts && bun run test:vitest -- devtools/standaloneSandpiperAppRuntime.test.ts",
    "test:claude-plugin": "bun run prepare:distribution && bun --filter sandpiper-adapter-claude-code build && bun run test:vitest -- packages/adapter-claude-code/src/autotoon-post-tool-use.test.ts devtools/claudeCodePlugin.test.ts devtools/claudeCodePluginHookSmoke.test.ts",
    "build:sandpiper-cli": "bun --filter sandpiper-ai-cli build:sandpiper",
    "prepare:standalone-app": "bun run --bun devtools/standaloneSandpiperApp.ts",
    "build:standalone-app": "bun run --bun devtools/standaloneSandpiperApp.ts --compile",
    "prepare:claude-plugin": "bun run prepare:distribution && bun --bun devtools/claudeCodePlugin.ts",
    "build:claude-plugin": "bun run prepare:distribution && bun --bun devtools/claudeCodePlugin.ts --build",
    "prepare:distribution": "bun run build:packages && bun --bun devtools/assembleDistribution.ts",
    "build:packages": "turbo run build --filter=sandpiper-ai-core --filter=sandpiper-standup-cli --filter=@sandpiper-ai/trail --filter=sandpiper-ai-cli",
    "build": "turbo run build --filter=sandpiper-ai-cli",
    "build:standalone": "bun --filter sandpiper-ai-cli build:standalone",
    "vendor": "bun --bun devtools/vendor.ts",
    "clean": "bun devtools/clean.ts",
    "sandpiper-dev": "bun run --bun ./packages/cli/sandpiper_standalone.ts",
    "sandpiper-built": "bun ./packages/cli/dist/sandpiper",
    "check:knip": "knip",
    "check:knip:production": "knip --production",
    "check:deps": "syncpack lint"
  },
  "workspaces": [
    "packages/*",
    "extensions/*",
    "plugins/pi/extensions"
  ],
  "dependencies": {
    "@sandpiper-ai/trail": "workspace:*",
    "better-sqlite3": "12.10.0",
    "sandpiper-ai-cli": "workspace:*",
    "sandpiper-ai-core": "workspace:*",
    "sandpiper-standup-cli": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.79.1",
    "@earendil-works/pi-tui": "0.79.1",
    "typebox": "1.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.9.2",
    "knip": "6.16.1",
    "syncpack": "15.3.1",
    "turbo": "2.9.17",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "license": "MIT",
  "type": "module"
}
