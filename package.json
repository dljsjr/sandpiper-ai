{
  "name": "sandpiper-ai-cli",
  "version": "0.0.1",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "author": "Doug Stephen <dljs.jr@dougstephenjr.com>",
  "homepage": "https://github.com/dljsjr/sandpiper-ai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dljsjr/sandpiper-ai.git"
  },
  "private": true,
  "files": [
    "packages/cli/bin/",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "docs/",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "bin": {
    "sandpiper": "./packages/cli/bin/sandpiper",
    "sandpiper-system-prompt": "./packages/cli/bin/sandpiper-system-prompt"
  },
  "piConfig": {
    "name": "sandpiper",
    "configDir": ".sandpiper",
    "bin": "sandpiper"
  },
  "scripts": {
    "check:biome-fmt": "biome format",
    "check:biome-lint": "biome lint",
    "check:biome-check": "biome check",
    "check:tsc": "tsc --noEmit",
    "check:ast-grep": "ast-grep scan",
    "check": "bun run check:deps && bun run check:tsc && bun run check:biome-check",
    "test": "bun run build && bun run test:vitest",
    "test:vitest": "env GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null JJ_CONFIG=\"$PWD/devtools/test-fixtures/jj-test-config.toml\" vitest run",
    "test:standalone": "bun run build && bun run test:vitest -- packages/cli/standalone_bootstrap.test.ts packages/cli/pi_asset_paths.test.ts packages/cli/sandpiper_resources.test.ts packages/cli/temporary_trail_skill.test.ts packages/cli/standalone_cli_smoke.test.ts packages/cli/standalone_resource_discovery.test.ts packages/cli/system_prompt_diagnostic.test.ts devtools/rootProductMetadata.test.ts devtools/packedCli.test.ts",
    "build": "rm -rf dist && bun build --sourcemap --production --minify --target=bun --splitting --chunk-naming 'chunks/[name]-[hash].[ext]' --external canvas --external css-tree --external jsdom --external '@earendil-works/*' --external '@mariozechner/*' ./packages/cli/sandpiper_standalone.ts ./packages/cli/sandpiper_system_prompt.ts --outdir ./dist",
    "pack:cli": "bun run build && bun pm pack --ignore-scripts --destination ./dist",
    "sandpiper-dev": "bun run --bun ./packages/cli/sandpiper_standalone.ts",
    "sandpiper-built": "bun ./packages/cli/bin/sandpiper",
    "system-prompt-dev": "bun run --bun ./packages/cli/sandpiper_system_prompt.ts",
    "system-prompt-built": "bun ./packages/cli/bin/sandpiper-system-prompt",
    "check:knip": "knip",
    "check:knip:production": "knip --production",
    "check:deps": "syncpack lint"
  },
  "workspaces": [
    "packages/*",
    "extensions/*"
  ],
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "jsdom": "30.0.1"
  },
  "bundledDependencies": [
    "@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent",
    "@earendil-works/pi-mcp",
    "@earendil-works/pi-tui",
    "jsdom"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "26.5.0",
    "knip": "6.35.1",
    "sandpiper-ai-core": "workspace:*",
    "sanitize-filename": "1.6.4",
    "syncpack": "15.3.3",
    "tmp": "0.2.7",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "uuid": "14.0.2",
    "vitest": "5.0.0"
  },
  "license": "MIT",
  "type": "module",
  "patchedDependencies": {
    "@earendil-works/pi-coding-agent@1.5.2": "patches/@earendil-works%2Fpi-coding-agent@1.5.2.patch"
  }
}
