{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",

  // Several modules export small helpers for same-file reuse. Report helpers only when
  // they are no longer used anywhere, not merely because they are exported from the file.
  "ignoreExportsUsedInFile": true,

  // Provided by the host system or developer environment, not by the npm dependency graph.
  "ignoreBinaries": ["ast-grep", "fish", "jj", "mkfifo", "rg"],

  "workspaces": {
    ".": {
      "entry": [
        "package.json!",
        "devtools/adoptTrailBoard.ts!",
        "devtools/syncSkillHelpers.ts!",
        "extensions/system.ts!"
      ],
      "project": [
        "extensions/*.ts!",
        "extensions/chorus/**/*.ts!",
        "extensions/tattler/**/*.ts!"
      ],
      // Root dependencies link these package-owned bin shims into node_modules/.bin.
      "ignoreDependencies": ["@sandpiper-ai/trail", "sandpiper-ai-cli", "sandpiper-standup-cli"]
    },

    "packages/cli": {
      "entry": [
        "bin/sandpiper!",
        "bin/sandpiper-system-prompt!",
        "sandpiper_standalone.ts!",
        "sandpiper_system_prompt.ts!"
      ],
      "project": ["*.ts!", "bin/*!"]
    },

    "packages/trail": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!"]
    },

    "packages/sandpiper-standup-cli": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!"]
    }
  }
}
