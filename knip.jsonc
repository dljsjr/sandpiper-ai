{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",

  // Report helpers only when unused everywhere, not merely exported from their own file.
  "ignoreExportsUsedInFile": true,

  // Production scans omit the build script that references these external runtime packages.
  "ignoreDependencies": [
    "@earendil-works/pi-ai!",
    "@earendil-works/pi-coding-agent!",
    "@earendil-works/pi-mcp!",
    "@earendil-works/pi-tui!",
    "jsdom!"
  ],

  "workspaces": {
    ".": {
      "entry": [
        "packages/cli/sandpiper_standalone.ts!",
        "packages/cli/sandpiper_system_prompt.ts!",
        // Test extensions are loaded by path in subprocesses rather than imported.
        "devtools/integration/mock-provider.ts",
        "devtools/integration/probe-tool.ts",
        "devtools/integration/fixtures/native-mcp/transport-probe.ts",
        "devtools/integration/fixtures/renderer-fixture.ts"
      ],
      "project": ["packages/**/*.ts!", "extensions/**/*.ts!", "devtools/**/*.ts"]
    }
  }
}
