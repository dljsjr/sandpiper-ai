{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "*.ts",
      "*.js",
      "**/*.ts",
      "**/*.js",
      "**/*.json",
      "!node_modules",
      "!**/node_modules",
      "!.turbo",
      "!**/.turbo",
      "!dist",
      "!**/dist",
      "!devtools/dash.ts",
      "!.sandpiper/jj-workspaces"
    ]
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "lineWidth": 120
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
