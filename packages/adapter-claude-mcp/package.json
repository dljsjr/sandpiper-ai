{
  "name": "sandpiper-adapter-claude-mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Claude Code stdio MCP adapter for neutral Sandpiper capabilities",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./src/server.ts"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "default": "./src/stdio.ts"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:mcp",
    "sandpiper-capability-autotoon": "workspace:*",
    "zod": "catalog:mcp"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
