{
  "$schema": "./node_modules/syncpack/schema.json",
  "source": [
    "package.json",
    "devtools/package.json",
    "extensions/*/package.json",
    "packages/*/package.json"
  ],
  "versionGroups": [
    {
      "label": "Root product uses workspace protocol for local packages",
      "packages": ["sandpiper-ai-cli"],
      "dependencies": ["$LOCAL"],
      "dependencyTypes": ["dev", "prod"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "Workspace package local dependency specs stay exact",
      "packages": ["!sandpiper-ai-cli"],
      "dependencies": ["$LOCAL"],
      "dependencyTypes": ["dev", "prod"]
    }
  ],
  "semverGroups": [
    {
      "label": "Ignore root local workspace protocols",
      "packages": ["sandpiper-ai-cli"],
      "dependencies": ["$LOCAL"],
      "isIgnored": true
    },
    {
      "label": "Use exact registry and package dependency versions",
      "range": ""
    }
  ]
}
